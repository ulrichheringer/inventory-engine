<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:InventoryEngine.ViewModels" mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700" x:Class="InventoryEngine.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="28" Spacing="16" MaxWidth="900" HorizontalAlignment="Center">
    <TextBlock Text="Inventory Engine" FontSize="30" FontWeight="Bold"/><TextBlock Text="Stacks, slots, peso e transferência entre inventários." Opacity="0.75"/>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="14"><Border Grid.Column="0" Padding="16" CornerRadius="8" Background="#DBEAFE"><StackPanel Spacing="8"><TextBlock Text="Mochila" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding BagContents}" FontFamily="monospace"/></StackPanel></Border><Border Grid.Column="1" Padding="16" CornerRadius="8" Background="#FEF3C7"><StackPanel Spacing="8"><TextBlock Text="Baú" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ChestContents}" FontFamily="monospace"/></StackPanel></Border></Grid>
    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Slot" VerticalAlignment="Center"/><NumericUpDown Value="{Binding SlotIndex}" Minimum="0" Maximum="5" Width="75"/><TextBlock Text="Quantidade" VerticalAlignment="Center"/><NumericUpDown Value="{Binding Amount}" Minimum="1" Maximum="99" Width="85"/></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Mochila → baú" Command="{Binding ToChestCommand}"/><Button Content="Baú → mochila" Command="{Binding ToBagCommand}"/></StackPanel><TextBlock Text="{Binding Status}"/>
  </StackPanel></ScrollViewer>
</UserControl>
